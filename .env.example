# --- Copy to .env for local runs (never commit .env) -------------------------
#
# This file serves BOTH roles of server.js. Which role you get is decided by one
# variable: UPSTREAM_PROXY_URL.
#
#   RELAY mode  (UPSTREAM_PROXY_URL set)    -> what runs on RENDER
#     Serves the SPA, forwards /api/council* to the proxy.
#     Reads NO Google credential. There is no Google token on this host, ever.
#
#   PROXY mode  (UPSTREAM_PROXY_URL unset)  -> what runs on CLOUD RUN
#     Calls Vertex AI Agent Engine directly. On Cloud Run its credential comes
#     from the metadata server: nothing stored, nothing to rotate or leak.
#
# ==============================================================================
# RELAY (Render) settings
# ==============================================================================

# The https URL of the Cloud Run proxy. Setting this switches on relay mode.
# UPSTREAM_PROXY_URL=https://council-proxy-xxxxxxxx-uc.a.run.app

# --- How the relay proves who it is to the proxy ------------------------------
#
# Preferred: Render's own OIDC token. Render mints a short-lived JWT per service
# and rotates it automatically; the proxy verifies it against Render's public
# JWKS. Nothing secret is stored on either side.
#
# You do not set the token yourself. Render provisions it when one of its OIDC
# integrations is enabled on the service; set AWS_ROLE_ARN to any placeholder
# and Render will write the token to a file and set AWS_WEB_IDENTITY_TOKEN_FILE
# to its path. (We never call AWS — we only reuse the signed identity.)
#   AWS_ROLE_ARN=arn:aws:iam::000000000000:role/unused-render-oidc-trigger
#
# If you would rather name the variable honestly, set RENDER_IDENTITY_TOKEN_FILE
# to the same path; server.js checks it first.
# RENDER_IDENTITY_TOKEN_FILE=

# Fallback shared secret for local dev and first-boot bring-up, before the OIDC
# subject has been pinned on the proxy. Long random string; same value on both
# services. Remove it once OIDC verification is confirmed working.
# RELAY_SECRET=

# ==============================================================================
# PROXY (Cloud Run) settings
# ==============================================================================

# Target reasoning engine coordinates. Needed in PROXY mode only.
GCP_PROJECT=ve-grp-1-333-project3-9rqd
GCP_REGION=us-central1
ENGINE_ID=8893446530510356480

# --- Which callers the proxy accepts ------------------------------------------
# Your Render workspace's OIDC issuer (workspace id starts with `tea-`, from the
# top of its Settings page).
# RENDER_OIDC_ISSUER=https://oidc.render.com/tea-csps46i3esus73eojjp0
#
# The `aud` claim Render puts in the token. Render sets this per integration —
# sts.amazonaws.com for the AWS integration. Comma-separated list accepted.
# RENDER_OIDC_AUDIENCE=sts.amazonaws.com
#
# THE IMPORTANT ONE. Without it, any Render-hosted service in the world with a
# token for this audience would be accepted. Pin your exact service:
#   workspace:<tea-...>:environment:<evm-...|default>:service:<srv-...>
# Read the value off GET /api/health as `lastVerifiedSub` after the first call.
# RENDER_ALLOWED_SUBS=

# ==============================================================================
# Google credential — PROXY mode only, and only OFF Cloud Run
# ==============================================================================
#
# On Cloud Run you set NONE of these: the metadata server is detected via
# K_SERVICE and ambient ADC is used. That is the whole point of this design.
#
# Locally, `gcloud auth application-default login` is enough (ambient ADC).
# The vars below exist for other hosts and for the future WIF upgrade.

# Full JSON contents of ANY Google credential file. Every type is accepted and
# auto-refreshed: authorized_user, service_account, external_account (workload
# identity federation), external_account_authorized_user (workforce),
# impersonated_service_account.
#
# WARNING: an `authorized_user` value here is YOUR PERSONAL credential — it
# carries the cloud-platform scope and can act as you across every project you
# can reach. This was the previous deployment model and is the reason for the
# Cloud Run proxy. Do not put one on a third-party host.
GOOGLE_ADC_JSON=

# Admin-issued service-account key JSON. Kept as a separate slot so it can
# coexist with the above. Also a long-lived downloadable key — prefer keyless.
GOOGLE_SA_KEY_JSON=

# Ambient ADC — no value. Point at a key file PATH, or run on GCP so the
# metadata server mints tokens. Keyless; no code change needed.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# LEGACY / last-resort — a static ~1h access token, NOT refreshed. /api/health
# reports degraded:true in this mode. Also used by the offline test suite.
#   gcloud auth application-default print-access-token
GOOGLE_ACCESS_TOKEN=

# ==============================================================================
# Abuse guards (both roles; set on the RELAY, which is the internet-facing one)
# ==============================================================================

# Require the x-council-key header on /api/council and /api/council/stream. Set
# any long random string AND give it to the SPA's users (the UI asks once and
# stores it in the browser). Unset = API is open (local dev).
# COUNCIL_API_KEY=

# Per-IP requests/minute on the council routes (default 10; 0 disables).
# Set 0 on the Cloud Run proxy — it only ever sees the relay's IP.
# RATE_LIMIT_PER_MIN=10

# Max council runs in flight at once across all clients (default 3).
# MAX_INFLIGHT=3

# Max prompt length in characters (default 4000).
# MAX_PROMPT_CHARS=4000

# Include raw upstream Vertex error bodies in client responses (debug only —
# they can reveal project/IAM details; server logs always capture them).
# DEBUG_UPSTREAM_ERRORS=1

# ==============================================================================
# Test / advanced
# ==============================================================================

# Override the Vertex endpoint. Used by e2e/offline.test.mjs to point at
# e2e/mock-vertex.mjs, which replays the real recorded engine event stream.
# VERTEX_BASE_URL=http://127.0.0.1:9099

# Agent identifiers used to route the synthesis. Defaults match the engine as
# deployed on 2026-07-16 (two-node workflow, chair agent renamed):
#   ROOT_AGENT_NAME=council_moderator     the Workflow / engine display name
#   ROOT_NODE_NAME=chair_decision         the terminal node (was
#                                         main_orchestration_workflow before
#                                         the 2026-07-16 split)
#   CHAIR_AGENT_NAME=council_chair        the synthesizing Agent inside it
# Only set these if you rename something in council_moderator/agent.py.
# ROOT_AGENT_NAME=council_moderator
# ROOT_NODE_NAME=chair_decision
# CHAIR_AGENT_NAME=council_chair

# Upstream stream timeout in ms (default 200000 = 200s). Sized for Render free
# tier sleep (~30-60s wake) plus agent cold start (20-60s).
# UPSTREAM_TIMEOUT_MS=200000

# PORT is injected automatically by Render and Cloud Run; only set it locally if
# you want a specific port. The server defaults to 8080 when PORT is unset.
# PORT=8080
